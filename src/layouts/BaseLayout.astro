---
import '../styles/global.css';
// Self-hosted fonts (Vite bundles the woff2 from our own origin), replacing the
// render-blocking Google Fonts stylesheet. Fraunces via its optical-size axis
// so headings keep size-appropriate letterforms; Inter for body. The italic
// face is not imported from fontsource: global.css declares a lowercase-only
// subset of it (~20KB rather than ~80KB) for the hero's one italic word.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/inter';
import { ClientRouter } from 'astro:transitions';
import { SITE_INDEXABLE, BUSINESS, DEFAULT_OG_IMAGE } from '../config';
import LeafMark from '../components/LeafMark.astro';

interface Props {
  title: string;
  description?: string;
  /** Keeps a page out of search results. For pages that only make sense as the
   * end of a journey — the form confirmation — not as an entry point. */
  noindex?: boolean;
  /** Social-share image: an absolute URL, or a site-relative path resolved
   * against `site`. Defaults to the shared placeholder. */
  image?: string;
}

const {
  title,
  description = BUSINESS.description,
  noindex = false,
  image = DEFAULT_OG_IMAGE,
} = Astro.props;

const pageTitle = `${title} | ${BUSINESS.name}`;
// The page's own canonical URL, and absolute share image, both built from
// `site` so they're the production origin even when previewed on localhost.
// Fall back to the request origin when `site` is unset (e.g. the Container API
// in unit tests), so rendering never throws on a missing base.
const base = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, base);
const ogImage = image.startsWith('http') ? image : new URL(image, base).href;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

// Which nav item is "here". Home matches only itself; a section link also
// matches its children (a project page lights up "Portfolio"), which is what
// `aria-current="page"` should reflect for someone reading the nav aloud.
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Safari has no SVG favicon support, so a PNG and the classic .ico back it up. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2f4a3d" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {
      /* While the site is a prototype every page is held back, not just the
         ones marked noindex individually. `nofollow` too, so a crawler that
         reaches one page does not spider outward from it. */
      (!SITE_INDEXABLE || noindex) && (
        <meta name="robots" content={SITE_INDEXABLE ? 'noindex' : 'noindex, nofollow'} />
      )
    }

    {/* Open Graph + Twitter, for link previews in messaging apps and socials. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
    <!--
      Marks JS as available before the first paint, which is what lets the
      scroll-reveal CSS hide elements without risking a blank page if the
      script never arrives. `is:inline` keeps it un-bundled and blocking —
      it must win the race against rendering, and it is one line.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {/* Per-page <head> extras — e.g. a page's structured-data block. */}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-paper font-body text-forest">
    <!--
      Sticky, translucent header: the page scrolls beneath it with a frosted
      blur, so the nav is always a thumb away on a phone without a solid bar
      eating into the photos. `z-40` keeps it above content; the lightbox sits
      at 100 and covers it deliberately.
    -->
    <header class="sticky top-0 z-40 bg-paper/85 backdrop-blur-md border-b border-earth-light/40">
      <nav class="max-w-6xl mx-auto px-6 py-4" aria-label="Main">
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-2.5 font-display text-xl text-forest">
            <LeafMark class="w-6 h-6 text-forest-light shrink-0" />
            <span>{BUSINESS.name}</span>
          </a>

          <!-- Desktop links: the whole list inline, from `sm` up. -->
          <ul class="hidden sm:flex gap-7 text-sm">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                    class="relative py-1 hover:text-forest-light transition-colors after:absolute after:left-0 after:-bottom-0.5 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:bg-clay after:transition-transform hover:after:scale-x-100 aria-[current=page]:font-medium aria-[current=page]:after:scale-x-100"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <!--
            Mobile toggle. `aria-expanded` is the state contract screen readers
            read; `aria-controls` ties it to the panel. Both are kept in sync by
            the script below. 44px min touch target per WCAG 2.5.5.
          -->
          <button
            type="button"
            id="nav-toggle"
            class="sm:hidden -mr-2 p-2 min-w-11 min-h-11 flex items-center justify-center"
            aria-expanded="false"
            aria-controls="nav-menu"
            aria-label="Menu"
          >
            <svg
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>

        <!--
          Mobile panel. Hidden via the `hidden` attribute rather than a class so
          it is genuinely removed from the accessibility tree when closed, not
          merely invisible.
        -->
        <ul id="nav-menu" hidden class="sm:hidden flex flex-col gap-1 pt-4 text-base">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class="block py-3 hover:text-forest-light transition-colors aria-[current=page]:font-medium"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-earth-light/40 mt-auto bg-moss/40">
      <div class="max-w-6xl mx-auto px-6 py-12 grid gap-10 sm:grid-cols-3 text-sm">
        <div>
          <p class="flex items-center gap-2 font-display text-lg text-forest mb-3">
            <LeafMark class="w-5 h-5 text-forest-light" />
            <span>{BUSINESS.name}</span>
          </p>
          <p class="text-forest/80 text-pretty">{BUSINESS.description}</p>
        </div>

        <nav aria-label="Footer">
          <p class="font-medium mb-3">Explore</p>
          <ul class="space-y-2 text-forest/80">
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="hover:text-forest transition-colors">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <p class="font-medium mb-3">Get in touch</p>
          <ul class="space-y-2 text-forest/80">
            {BUSINESS.areaServed && <li>Serving {BUSINESS.areaServed}</li>}
            <li>
              <a href={`mailto:${BUSINESS.email}`} class="underline hover:text-forest">
                {BUSINESS.email}
              </a>
            </li>
            {
              BUSINESS.telephoneDisplay && (
                <li>
                  <a href={`tel:${BUSINESS.telephone}`} class="underline hover:text-forest">
                    {BUSINESS.telephoneDisplay}
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </div>
      <div class="border-t border-earth-light/30">
        <p class="max-w-6xl mx-auto px-6 py-4 text-xs text-forest/80">
          &copy; {new Date().getFullYear()}{' '}{BUSINESS.name}
        </p>
      </div>
    </footer>

    <script>
      // The site's only always-present JS. Everything else stays zero-JS
      // unless a page opts in.
      //
      // Every listener here is delegated to `document` and looks its elements
      // up at call time. That is not stylistic: view transitions replace the
      // <body> on each navigation, so a listener bound directly to the toggle
      // would be thrown away with the old DOM, and one bound once to a captured
      // element would go on pointing at a node no longer in the page. Delegation
      // means this binds once and keeps working, with nothing to re-initialise.

      const setOpen = (open: boolean) => {
        const toggle = document.getElementById('nav-toggle');
        const menu = document.getElementById('nav-menu');
        if (!toggle || !menu) return;

        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.closest('#nav-toggle')) return;

        // `hidden` types as `boolean | string` (the `until-found` value), so
        // coerce rather than pass it straight through.
        setOpen(Boolean(document.getElementById('nav-menu')?.hidden));
      });

      // Escape closes and returns focus to the toggle — otherwise keyboard
      // users are stranded inside an open panel.
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const menu = document.getElementById('nav-menu');
        if (!menu || menu.hidden) return;

        setOpen(false);
        document.getElementById('nav-toggle')?.focus();
      });

      // Crossing the `sm` breakpoint with the panel open would otherwise
      // leave a stale `hidden` state behind when the desktop list takes over.
      window.matchMedia('(min-width: 40rem)').addEventListener('change', (event) => {
        if (event.matches) setOpen(false);
      });

      // ---- Scroll reveal ----------------------------------------------------
      // The CSS does the animating; this only decides when. Elements start
      // hidden solely via the `.js` gate, so if this script fails they stay
      // visible rather than disappearing.

      let observer: IntersectionObserver | null = null;

      const revealAll = (targets: NodeListOf<Element>) => {
        targets.forEach((el) => el.setAttribute('data-revealed', ''));
      };

      const initReveal = () => {
        const targets = document.querySelectorAll('[data-reveal]:not([data-revealed])');
        if (targets.length === 0) return;

        // Checked here rather than only in CSS so we skip the observer work
        // entirely, and so anything below the fold is shown immediately.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealAll(targets);
          return;
        }

        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute('data-revealed', '');
              // One-shot: re-animating on every scroll past is a nuisance, not
              // a delight.
              observer?.unobserve(entry.target);
            }
          },
          // Fire a little before the element is fully in view, so the movement
          // reads as the page settling rather than as a delayed reaction.
          { rootMargin: '0px 0px -10% 0px' }
        );

        targets.forEach((el) => observer?.observe(el));
      };

      // Runs on first load; `astro:page-load` covers every view transition after
      // it, where the new page arrives with its own un-revealed elements.
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
      document.addEventListener('astro:before-swap', () => {
        observer?.disconnect();
        observer = null;
      });
    </script>
  </body>
</html>
