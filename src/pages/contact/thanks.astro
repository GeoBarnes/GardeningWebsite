---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BUSINESS } from '../../config';

// Where Formspree sends people after a successful submission, via the `_next`
// field on the contact form. `noindex` because it only makes sense as the end
// of a journey — landing here from a search result would be baffling.
//
// Contact details come from BUSINESS like everywhere else, so this page can't
// drift from the footer, the contact page, or the JSON-LD.
---

<BaseLayout title="Message sent" noindex>
  <section class="max-w-2xl mx-auto px-6 py-20 sm:py-24">
    <p class="text-sm uppercase tracking-widest text-forest-light mb-4">Thank you</p>
    <h1 class="font-display text-4xl sm:text-5xl text-balance mb-4">Your message is on its way</h1>
    <p class="text-forest/80 text-pretty mb-8">
      I read every enquiry personally and aim to reply within a couple of working days.
      {BUSINESS.telephoneDisplay && " If it's urgent, do give me a ring."}
    </p>

    <div class="text-forest/80 text-sm space-y-1">
      {
        BUSINESS.telephoneDisplay && (
          <p>
            Phone:{' '}
            <a href={`tel:${BUSINESS.telephone}`} class="underline">
              {BUSINESS.telephoneDisplay}
            </a>
          </p>
        )
      }
      <p>Email: <a href={`mailto:${BUSINESS.email}`} class="underline">{BUSINESS.email}</a></p>
    </div>

    <a
      href="/"
      class="inline-block mt-10 bg-forest text-white px-6 py-3 rounded-full font-medium hover:bg-forest-light transition-colors"
    >
      Back to the home page
    </a>
  </section>
</BaseLayout>
