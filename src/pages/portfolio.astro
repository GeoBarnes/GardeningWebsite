---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Portfolio"
  description="Recent garden design and planting projects — wildlife ponds, borders, pergolas and patios."
>
  <section class="max-w-6xl mx-auto px-6 pt-16 sm:pt-20 pb-20 sm:pb-24">
    <div class="max-w-2xl mb-12">
      <p class="text-sm uppercase tracking-widest text-forest-light mb-3">Portfolio</p>
      <h1 class="font-display text-4xl sm:text-5xl text-balance mb-4">Recent work</h1>
      <p class="text-forest/80 text-lg text-pretty">
        A selection of garden design and planting projects. Every garden here started with a
        conversation about how someone wanted to use their space.
      </p>
    </div>

    {
      /* Two columns, with the newest project spanning both: three items then
         sit as one wide card over two narrow ones, with no hole. */
    }
    <div class="grid sm:grid-cols-2 gap-8 md:gap-10" data-reveal-stagger>
      {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>

  <CtaBand
    heading="Have a garden that could use some help?"
    body="Whether it is a blank plot or a border that has got away from you, I would love to hear about it."
  />
</BaseLayout>
