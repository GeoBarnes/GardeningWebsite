---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveLocalImage } from '../lib/localImages';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Portfolio">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="font-display text-3xl mb-2">Portfolio</h1>
    <p class="text-forest/80 mb-10">A selection of recent garden design and planting projects.</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((project) => {
          const cover = project.data.images[0];
          const asset = resolveLocalImage(cover.src);
          const alt = cover.alt ?? project.data.title;
          const cardClass =
            'w-full aspect-[3/2] object-cover rounded-lg mb-3 transition-opacity group-hover:opacity-90';
          return (
            <article class="group" data-reveal>
              <a href={`/portfolio/${project.id}/`}>
                {asset ? (
                  <Image
                    src={asset}
                    alt={alt}
                    widths={[400, 640]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                    loading="lazy"
                    class={cardClass}
                  />
                ) : (
                  <img
                    src={cover.src}
                    alt={alt}
                    width={cover.width}
                    height={cover.height}
                    loading="lazy"
                    class={cardClass}
                  />
                )}
                <h2 class="font-display text-lg">{project.data.title}</h2>
                <p class="text-forest/80 text-sm">{project.data.summary}</p>
              </a>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
